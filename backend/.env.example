# Backend service variables
APP_NAME=PulseOps API
APP_VERSION=0.1.0
PULSEOPS_ENV=development
LOG_LEVEL=INFO

# PostgreSQL configuration
DATABASE_URL=******localhost:5432/pulseops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulseops
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=pulseops

# Redis configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# AI provider configuration
AI_PROVIDER=mock
AI_MODEL=mock-local-model
OPENAI_API_KEY=
GROQ_API_KEY=
